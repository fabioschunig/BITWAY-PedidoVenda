    </Target>
    <Target Name="Clean">
        <CallTarget Targets="PedidoVenda:Clean;PedidoVendaTests:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="PedidoVenda:Make;PedidoVendaTests:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
